          },
          "expr": "sum(increase(agent_llm_shadow_cost_usd_total[24h])) + sum(increase(agent_infra_cost_usd_total[24h]))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
