{
  "uid": "sre-cluster-live",
  "title": "SRE Copilot: live cluster issues",
  "tags": [
    "sre-copilot",
    "kubernetes",
    "troubleshooting"
  ],
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "refresh": "15s",
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace (logs)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "query": {
          "query": "label_values(kube_namespace_status_phase, namespace)",
          "refId": "ns"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "sre-sandbox",
          "value": "sre-sandbox"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "1. Status now",
      "id": 1,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Namespaces",
      "id": 2,
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "count(kube_namespace_status_phase{phase=\"Active\"})",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "type": "stat",
      "title": "Nodes ready",
      "id": 3,
      "description": "",
