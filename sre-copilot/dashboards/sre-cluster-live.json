          },
          "expr": "(sum(kube_deployment_spec_replicas - kube_deployment_status_replicas_available > 0)) or vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "type": "stat",
      "title": "Quotas at limit",
      "id": 8,
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "(count(kube_resourcequota{type=\"used\"} >= on (namespace, resourcequota, resource) kube_resourcequota{type=\"hard\"})) or vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "type": "row",
      "title": "2. What is broken right now (live from the cluster)",
      "id": 9,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "bargauge",
      "title": "Issues by type",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 10,
        "w": 9,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "(count(kube_pod_container_status_waiting_reason{reason=~\"ImagePullBackOff|ErrImagePull\"} == 1)) or vector(0)",
          "legendFormat": "ImagePullBackOff",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "(count(kube_pod_container_status_waiting_reason{reason=\"CrashLoopBackOff\"} == 1)) or vector(0)",
          "legendFormat": "CrashLoopBackOff",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "(count(kube_pod_container_status_waiting_reason{reason=\"CreateContainerConfigError\"} == 1)) or vector(0)",
          "legendFormat": "CreateContainerConfigError",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "(count(kube_pod_container_status_last_terminated_reason{reason=\"OOMKilled\"} == 1)) or vector(0)",
          "legendFormat": "OOMKilled",
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "(count(kube_pod_status_unschedulable == 1)) or vector(0)",
          "legendFormat": "Pending (unschedulable)",
          "refId": "E"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "(count((kube_pod_status_ready{condition=\"false\"} == 1) and on (namespace, pod) (kube_pod_status_phase{phase=\"Running\"} == 1))) or vector(0)",
          "legendFormat": "Readiness failing",
          "refId": "F"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "(count(kube_endpoint_address_available == 0)) or vector(0)",
          "legendFormat": "Service, 0 ready endpoints",
          "refId": "G"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "(count(kube_resourcequota{type=\"used\"} >= on (namespace, resourcequota, resource) kube_resourcequota{type=\"hard\"})) or vector(0)",
          "legendFormat": "Quota at limit",
          "refId": "H"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "(count(kube_deployment_spec_replicas - kube_deployment_status_replicas_available > 0)) or vector(0)",
          "legendFormat": "Replicas missing",
          "refId": "I"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "table",
      "title": "All current issues",
      "id": 11,
      "description": "Every failure the cluster shows right now in one list. Detail and raw evidence are in section 6.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 10,
        "w": 15,
        "x": 9,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by (namespace, pod, issue, impact) (label_replace(label_replace(kube_pod_container_status_waiting_reason{reason=~\"ImagePullBackOff|ErrImagePull|CrashLoopBackOff|CreateContainerConfigError\"} == 1, \"issue\", \"$1\", \"reason\", \"(.*)\"), \"impact\", \"Workload down\", \"\", \"\"))\n or sum by (namespace, pod, issue, impact) (label_replace(label_replace(kube_pod_container_status_last_terminated_reason{reason=\"OOMKilled\"} == 1, \"issue\", \"OOMKilled\", \"\", \"\"), \"impact\", \"Workload down\", \"\", \"\"))\n or sum by (namespace, pod, issue, impact) (label_replace(label_replace(kube_pod_status_unschedulable == 1, \"issue\", \"Pending: cannot be scheduled\", \"\", \"\"), \"impact\", \"Workload down\", \"\", \"\"))\n or sum by (namespace, pod, issue, impact) (label_replace(label_replace((kube_pod_status_ready{condition=\"false\"} == 1) and on (namespace, pod) (kube_pod_status_phase{phase=\"Running\"} == 1), \"issue\", \"Readiness probe failing\", \"\", \"\"), \"impact\", \"Not serving traffic\", \"\", \"\"))\n or sum by (namespace, pod, issue, impact) (label_replace(label_replace(label_replace(kube_endpoint_address_available == 0, \"issue\", \"Service has 0 ready endpoints\", \"\", \"\"), \"impact\", \"Traffic blocked\", \"\", \"\"), \"pod\", \"service/$1\", \"endpoint\", \"(.*)\"))\n or sum by (namespace, pod, issue, impact) (label_replace(label_replace(label_replace(kube_resourcequota{type=\"used\"} >= on (namespace, resourcequota, resource) kube_resourcequota{type=\"hard\"}, \"issue\", \"Quota at limit\", \"\", \"\"), \"impact\", \"Cannot create pods\", \"\", \"\"), \"pod\", \"quota/$1\", \"resourcequota\", \"(.*)\"))\n or sum by (namespace, pod, issue, impact) (label_replace(label_replace(label_replace((kube_deployment_spec_replicas - kube_deployment_status_replicas_available > 0) and on (namespace, deployment) (kube_deployment_status_replicas_available > 0), \"issue\", \"Replicas missing (partly available)\", \"\", \"\"), \"impact\", \"Degraded\", \"\", \"\"), \"pod\", \"deployment/$1\", \"deployment\", \"(.*)\"))",
          "legendFormat": "",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "namespace",
                "pod",
                "issue",
                "impact"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "namespace": "Namespace",
              "pod": "Object",
              "issue": "Issue",
              "impact": "Impact"
            },
            "indexByName": {
              "namespace": 0,
              "pod": 1,
              "issue": 2,
              "impact": 3
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Impact"
              },
              {
                "field": "Object"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "type": "row",
      "title": "3. Timeline",
      "id": 12,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Unhealthy pods over time",
      "id": 13,
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "count(kube_pod_container_status_waiting_reason{reason=~\"ImagePullBackOff|ErrImagePull|CrashLoopBackOff|CreateContainerConfigError\"} == 1) or vector(0)",
          "legendFormat": "stuck waiting",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "count(kube_pod_status_unschedulable == 1) or vector(0)",
          "legendFormat": "unschedulable",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "count((kube_pod_status_ready{condition=\"false\"} == 1) and on (namespace, pod) (kube_pod_status_phase{phase=\"Running\"} == 1)) or vector(0)",
          "legendFormat": "not ready",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Warning events by reason",
      "id": 14,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "(sum by (reason) (count_over_time({job=\"k8s-events\"} | logfmt | type=\"Warning\" [$__interval])))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ]
        }
      }
    },
    {
      "type": "row",
      "title": "4. Namespaces, pods and deployments",
      "id": 15,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "table",
      "title": "Namespaces: pods by phase",
      "id": 16,
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 25
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by (namespace) (kube_pod_status_phase{phase=\"Running\"})",
          "legendFormat": "",
          "refId": "A",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by (namespace) (kube_pod_status_phase{phase=\"Pending\"}) or sum by (namespace) (kube_pod_status_phase{phase=\"Running\"}) * 0",
          "legendFormat": "",
          "refId": "B",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by (namespace) (kube_pod_status_phase{phase=\"Failed\"}) or sum by (namespace) (kube_pod_status_phase{phase=\"Running\"}) * 0",
          "legendFormat": "",
          "refId": "C",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by (namespace) (increase(kube_pod_container_status_restarts_total[$__range])) or sum by (namespace) (kube_pod_status_phase{phase=\"Running\"}) * 0",
          "legendFormat": "",
          "refId": "D",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "namespace",
                "Value #A",
                "Value #B",
                "Value #C",
                "Value #D"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "namespace": "Namespace",
              "Value #A": "Running",
              "Value #B": "Pending",
              "Value #C": "Failed",
              "Value #D": "Restarts (range)"
            },
            "indexByName": {
              "namespace": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "type": "table",
      "title": "Deployments: desired vs available",
      "id": 17,
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
